# Produkční konfigurace dema bez domácího PC (P30A, režisér astra od P71A). Po doplnění úložiště
# (KV_REST_API_URL / KV_REST_API_TOKEN) projde
#   node scripts/cloud/check-env.mjs scripts/cloud/env.production.example
# Klíče se vyplňují jen ve Vercelu (Project → Settings → Environment Variables),
# nikdy sem. Postup nasazení: scripts/cloud/README.md.
#
# Všechny stropy v USD jsou SOUČTOVÉ ZA CELOU DOBU KNIHY, ne měsíční: kniha ve sdíleném úložišti
# (předpona WORLDSMITH_SPEND_STORE_PREFIX) sčítá útratu od prvního volání a sama se nevynuluje.
# Další měsíc = vyšší strop ve Vercelu a redeploy; nová kniha = nová předpona.

# Živá větev: bez `live` hraje demo jen návrhy ze slov.
WORLDSMITH_BRANCH=live

# Kniha útraty: základ jména klíčů ve sdíleném úložišti. Prázdná = kontrola výš selže (sdílela by
# knihu s dřívějšími nasazeními `worldsmith:spend` a jejich útratou).
WORLDSMITH_SPEND_STORE_PREFIX=sayplay

# Režisér gpt-6-astra přes placené OpenAI API (rozhodnutí majitele 5. 11.). Ceny 10/50 USD za Mtok
# podle ceníku OpenAI (týž model jako čtečka, kontrola výš chce v obou knihách stejnou cenu).
WORLDSMITH_MODEL_PROFILE=metered
WORLDSMITH_MODEL_ENDPOINT=openai:https://api.openai.com
WORLDSMITH_MODEL=gpt-6-astra
WORLDSMITH_MODEL_KEY=
WORLDSMITH_USD_PER_MTOK_IN=10
WORLDSMITH_USD_PER_MTOK_OUT=50
WORLDSMITH_SPEND_CAP_USD=60
# Počet volání: strop / nejhorší případ jednoho volání (8000 tokenů × 50 USD/Mtok = 0,40 USD) = 150.
# Odhad P59 je ~0,65 USD za AI verzi, takže dřív kousne dolarový strop; 160 je rezerva nad mezí.
WORLDSMITH_CALL_CAP=160

# Kolik volání režiséra smí jeden návštěvník za den (dnes výchozích 12): 6 = nejvýš 2 AI verze denně.
PLAY_DIRECTOR_CALLS_PER_CALLER=6

# Záloha režiséra je při astře jako režisérovi VYPNUTÁ: všechny WORLDSMITH_FALLBACK_* prázdné.
# Vyplněná jen část (třeba jen klíč) = kontrola výš selže, server by zálohu tiše nezapnul.
WORLDSMITH_FALLBACK_ENDPOINT=
WORLDSMITH_FALLBACK_MODEL=
WORLDSMITH_FALLBACK_KEY=
WORLDSMITH_FALLBACK_USD_PER_MTOK_IN=
WORLDSMITH_FALLBACK_USD_PER_MTOK_OUT=
WORLDSMITH_FALLBACK_SPEND_CAP_USD=
WORLDSMITH_FALLBACK_CALL_CAP=

# Čtečka věty (P58B): astra přes OpenAI API čte jen pro AI verzi – p95 6,4 s, rychlou
# hru do 2 s nestihne, ta hraje ze slov (evals/play/p58b/README.md). Při chybě, vypršení
# nebo plném stropu čte i AI verze ze slov. Ceny 10/50 USD za Mtok podle ceníkových
# přehledů, změřeno 0,027 USD za větu; před nasazením ověř na ceníku OpenAI.
PLAY_READER=on
PLAY_READER_PATH=ai
PLAY_READER_ENDPOINT=openai:https://api.openai.com
PLAY_READER_MODEL=gpt-6-astra
PLAY_READER_KEY=
PLAY_READER_USD_PER_MTOK_IN=10
PLAY_READER_USD_PER_MTOK_OUT=50
# Strop čtečky v USD, vlastní kniha (ne režisérova).
PLAY_READER_SPEND_CAP_USD=10
# Kontrola výš chce aspoň strop / nejhorší případ (1024 tokenů × 50 USD/Mtok = 0,0512 USD) = 196.
# Změřené čtení ale stojí 0,027 USD, takže 10 USD vystačí na ~370 čtení: 400, ať první kousne dolarový strop.
PLAY_READER_CALL_CAP=400

# Celkový rozpočet (P68I T7): součet stropů režiséra, zálohy a čtečky (+ PLAY_SCRIPTS_SPEND_CAP_USD,
# když PLAY_SCRIPTS=on) nesmí být větší. 60 + 0 + 10 = 70.
PLAY_TOTAL_SPEND_CAP_USD=70

# Rezerva pro porotu: do PLAY_JUDGING_FROM (ISO datum, hodiny serveru) smí veřejný provoz utratit jen
# WORLDSMITH_SPEND_CAP_USD − PLAY_JUDGING_RESERVE_USD (60 − 40 = 20 USD), od toho data celý strop.
# 2026-11-11T14:30:00Z = 15:30 pražského času. Obě prázdné = bez rezervy; jen jedna vyplněná nebo
# překlep v datu = kontrola výš selže.
PLAY_JUDGING_FROM=2026-11-11T14:30:00Z
PLAY_JUDGING_RESERVE_USD=40

# Kolik režií smí na instanci běžet naráz (P53); prázdné = 2, víc než 2 nejde
# (rezerva dveří /studio). Kontrola výš ji odmítne mimo 1..2.
PLAY_DIRECTOR_SLOTS=

# Panoramata: bez služby hraje předpečená knihovna public/play/env.
PLAY_ENV_ENDPOINT=
PLAY_ENV_KEY=

# Hlas vypravěče přes hostované Kokoro (DeepInfra), ≤ 0,00015 USD za hru.
PLAY_VOICE_ENDPOINT=openai-speech:https://api.deepinfra.com/v1/openai
PLAY_VOICE_MODEL=hexgrad/Kokoro-82M
PLAY_VOICE_KEY=

# Sdílené úložiště (knihy stropů, hry, cache) dodá integrace Upstash ve Vercelu
# jako KV_REST_API_URL / KV_REST_API_TOKEN; ručně se nevyplňuje.
