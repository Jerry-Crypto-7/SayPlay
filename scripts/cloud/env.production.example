# Produkční konfigurace dema bez domácího PC (P30A). Projde
#   node scripts/cloud/check-env.mjs scripts/cloud/env.production.example
# Klíče se vyplňují jen ve Vercelu (Project → Settings → Environment Variables),
# nikdy sem. Postup nasazení: scripts/cloud/README.md.

# Živá větev: bez `live` hraje demo jen návrhy ze slov.
WORLDSMITH_BRANCH=live

# Režisér gpt-oss-20b přes sdílené API, placený po tokenech (Together; Fireworks:
# openai:https://api.fireworks.ai/inference a jméno modelu podle Fireworks).
WORLDSMITH_MODEL_PROFILE=metered
WORLDSMITH_MODEL_ENDPOINT=openai:https://api.together.xyz
WORLDSMITH_MODEL=openai/gpt-oss-20b
WORLDSMITH_MODEL_KEY=
WORLDSMITH_USD_PER_MTOK_IN=0.05
WORLDSMITH_USD_PER_MTOK_OUT=0.20
# Kumulativní strop v USD (kniha ve sdíleném úložišti), ne měsíční okno.
WORLDSMITH_SPEND_CAP_USD=30
# Počet volání: strop / nejhorší případ jednoho volání (8000 tokenů × 0,20 USD/Mtok = 0,0016 USD) = 18 750.
WORLDSMITH_CALL_CAP=20000

# Záloha astra přes OpenAI API, vlastní strop a kniha. Ceny jako u čtečky (týž model, ceník OpenAI):
# nižší cena v knize by strop v dolarech pustila několikrát dál, než říká.
WORLDSMITH_FALLBACK_ENDPOINT=openai:https://api.openai.com
WORLDSMITH_FALLBACK_MODEL=gpt-6-astra
WORLDSMITH_FALLBACK_KEY=
WORLDSMITH_FALLBACK_USD_PER_MTOK_IN=10
WORLDSMITH_FALLBACK_USD_PER_MTOK_OUT=50
WORLDSMITH_FALLBACK_SPEND_CAP_USD=20
# Strop / nejhorší případ (8000 tokenů × 50 USD/Mtok = 0,40 USD) = 50; s rezervou.
WORLDSMITH_FALLBACK_CALL_CAP=60

# Čtečka věty (P58B): astra přes OpenAI API čte jen pro AI verzi – p95 6,4 s, rychlou
# hru do 2 s nestihne, ta hraje ze slov (evals/play/p58b/README.md). Při chybě, vypršení
# nebo plném stropu čte i AI verze ze slov. Ceny 10/50 USD za Mtok podle ceníkových
# přehledů, změřeno 0,027 USD za větu; před nasazením ověř na ceníku OpenAI.
PLAY_READER=on
PLAY_READER_PATH=ai
PLAY_READER_ENDPOINT=openai:https://api.openai.com
PLAY_READER_MODEL=gpt-6-astra
PLAY_READER_KEY=
PLAY_READER_USD_PER_MTOK_IN=10
PLAY_READER_USD_PER_MTOK_OUT=50
# Kumulativní strop čtečky v USD, vlastní kniha (ne režisérova).
PLAY_READER_SPEND_CAP_USD=20
# Kontrola výš chce aspoň strop / nejhorší případ (1024 tokenů × 50 USD/Mtok = 0,0512 USD) = 391.
# Změřené čtení ale stojí 0,027 USD, takže 20 USD vystačí na ~740 čtení: 800, ať první kousne dolarový strop.
PLAY_READER_CALL_CAP=800

# Kolik režií smí na instanci běžet naráz (P53); prázdné = 2, víc než 2 nejde
# (rezerva dveří /studio). Kontrola výš ji odmítne mimo 1..2.
PLAY_DIRECTOR_SLOTS=

# Panoramata: bez služby hraje předpečená knihovna public/play/env.
PLAY_ENV_ENDPOINT=
PLAY_ENV_KEY=

# Hlas vypravěče přes hostované Kokoro (DeepInfra), ≤ 0,00015 USD za hru.
PLAY_VOICE_ENDPOINT=openai-speech:https://api.deepinfra.com/v1/openai
PLAY_VOICE_MODEL=hexgrad/Kokoro-82M
PLAY_VOICE_KEY=

# Sdílené úložiště (knihy stropů, hry, cache) dodá integrace Upstash ve Vercelu
# jako KV_REST_API_URL / KV_REST_API_TOKEN; ručně se nevyplňuje.
