# --- Interní materiály (NEMAZAT) ---
# Tenhle repozitář se stane VEŘEJNÝM (povinný deliverable, RULES.md §2). Pracovní strom
# vedle produktu nese interní podklady: bezpečnostní nález třetí strany, strategické
# rozvahy, plány a pracovní logy. Nic z toho není povinný deliverable a nic z toho se
# nesmí dostat do historie – smazání po commitu problém neřeší, historie zůstává.
SECURITY-FINDINGS.md

# Config kontroly před nahráním. Nese skutečné jméno autora a handly, které se
# hledají v identitě commitů – tedy přesně to, co se nesmí nahrát. `blind-check.mjs`
# proto SELŽE, kdyby se tenhle soubor ocitl mezi trackovanými.
blind-check.config.json

# Seznam zakázaných identifikátorů z proprietárního modulu třetí strany.
# Sám nese ta jména, takže commitnout ho znamená vynést přesně to, čemu má bránit
# – stejný důvod a stejná přísnost jako u SECURITY-FINDINGS.md.
# `cleanroom-check.mjs` je proto fail-closed: bez seznamu SELŽE, nepřeskočí se.
# Provisioning nového klonu: ops/cleanroom-provisioning.md
scripts/cleanroom-forbidden.txt

# Interní dokumentace, plány a pracovní logy.
# Veřejné repo nese produkt, ne strategii. P8 do něj přidá vlastní README.md
# a DISCLOSURE.md – proto ty dvě negace. Vzor /*.md míří jen na kořen, takže
# evals/README.md ani dokumentace uvnitř src/ tím dotčené nejsou.
/*.md
!README.md
!DISCLOSURE.md
plans/
.claude/

# Syrové odpovědi poskytovatele z živého běhu (T18). Nejsou artefakt k
# commitnutí – jsou to naměřená data jednoho běhu, nesou plné znění promptů
# i odpovědí a repo půjde podle RULES.md §2 ven. Adresář sám zůstává.
evals/live/*
!evals/live/.gitkeep

# Totéž o vlnu později a pod jiným jménem: archiv živého create běhu (P13 T14).
# Nese plné znění promptů i odpovědí, tedy tutéž třídu dat jako evals/live.
# `create-report.json` vedle něj se commituje schválně – je to naměřené číslo,
# na kterém stojí brána K2, a scrubuje ho `LiveEmitter.scrub()`.
evals/worldstream/create-raw.json

# Report z vývojového profilu (předplatné). Leží ve stejném adresáři jako
# oficiální evals/kill-gate-report.json a je to přesně ta záměna, které má
# celý profil bránit: levné číslo vedle toho, na kterém stojí rozhodnutí.
# Vyhrazené jméno kill-gate-report.json commitnutelné zůstává.
evals/dev-report.*.json

# Vazba tagu na artefakt, výstup `npm run build:from-tag`. Necommituje se ze dvou
# důvodů: nese hash commitu, ve kterém by musel ležet, a pipeline sama vyžaduje
# čistý strom – trackovaný by po každém běhu shodil ten další na vlastním výstupu.
ops/fallback-v1-lock.json

# Secrets obecně
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# Node / Next.js
node_modules/
.next/
out/
# Reporty z `ANALYZE=true`. Klientský končí v `.next/analyze/`, serverový podle
# výstupního adresáře webpacku v kořeni – proto oba vzory.
/analyze/
# Odstavené jádro během `npm run prove:fallback`. Za normálního běhu adresář
# nepřežije jednu vteřinu; po tvrdém zabití procesu je to jediná kopie, kterou
# vrátí `node scripts/prove-fallback-isolation.mjs --restore`.
.isolation-quarantine/
build/
dist/
*.tsbuildinfo
.turbo/

# Test a coverage
coverage/
.nyc_output/
playwright-report/
test-results/
*-snapshots/__diff_output__/

# Assety – zdrojové soubory pipeline se necommitují, jen normalizovaný kit
assets/raw/
assets/_work/
*.blend1
*.fbx

# Nástroje a cache
.cache/
.eslintcache
.vercel/
public/sw.js
public/workbox-*.js

# OS a editory
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Lokální scratch. Agenti opakovaně nechávají v kořeni analytické jednorázovky
# (`tmp-dump.cjs`, `.tmp-review.mjs`, `lower.bak.tmp`) a `rm` jim sandbox odmítá.
# Repo bude podle RULES.md §2 veřejné – tohle je pojistka, ne úklid.
scratch/
scratch-*
tmp/
tmp-*
.tmp-*
*.bak.tmp
.playwright-mcp/

# Provozní logy hlídačů. `ops/worldstream-watchdog.jsonl` je dokumentovaná cesta
# a nese cílovou URL i názvy světů; do 3. 9. 2026 nesla i živé `sessionId`, což
# je schopnost, ne identifikátor. Repo jde podle RULES.md §2 ven.
ops/**/*.jsonl
