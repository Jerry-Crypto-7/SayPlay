    { "id": "zone_trigger", "params": { "role": "shore", "when": "enter", "effect": "win" } },
    { "id": "checkpoint", "params": { "role": "slab", "count": 4, "ordered": false } }
  ],
  "roles": [
    { "id": "player", "kind": "player", "label": "fire newt", "count": 1 },
    { "id": "magma", "kind": "hazard", "label": "magma pool", "count": 6 },
    { "id": "slab", "kind": "checkpoint", "label": "basalt slab", "count": 4 },
    { "id": "shore", "kind": "exit", "label": "far shore", "count": 1 }
  ],
  "tutorial": { "goalLine": "Cross the magma to the far shore. Pools pulse.", "controlsHint": "Tap a slab when the magma beside it is dark." },
