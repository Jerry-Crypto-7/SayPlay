    { "id": "slab_counts", "kind": "keypoint", "mechanic": "checkpoint", "setup": { "counters": { "slabsReached": 0 } }, "actions": [{ "actionId": "moveTo", "target": "slab" }], "assert": { "counters": { "slabsReached": 1 } } },
    { "id": "shore_wins", "kind": "keypoint", "mechanic": "zone_trigger", "setup": { "placeAt": { "player": "shore" } }, "ticks": 5, "assert": { "runState": "won" } },
    { "id": "winnable", "kind": "reachability", "assert": { "runState": "won" } }
