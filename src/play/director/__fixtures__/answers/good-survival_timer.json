{
  "schema": "gamespec.v1",
  "title": "Rooftop Sweep",
  "archetype": "survival_timer",
  "targetDurationSec": 90,
  "theme": { "setting": "city rooftop at night", "mood": "tense" },
  "objective": { "kind": "survive", "description": "Stay out of the searchlights for 90 seconds.", "seconds": 90 },
  "mechanics": [
    { "id": "timer", "params": { "id": "clock", "seconds": 90, "onEnd": "win" } },
    { "id": "hazard_zone", "params": { "role": "searchlight", "effect": "lose", "pulse": { "onSeconds": 2, "offSeconds": 4 } } }
  ],
  "roles": [
    { "id": "player", "kind": "player", "label": "courier", "count": 1 },
    { "id": "searchlight", "kind": "hazard", "label": "drone searchlight", "count": 5 },
    { "id": "vent", "kind": "prop", "label": "steam vent", "count": 2 }
  ],
  "tutorial": { "goalLine": "Dodge the searchlights for 90 seconds.", "controlsHint": "Tap a dark spot to move there." },
  "verification": [
    { "id": "light_catches", "kind": "keypoint", "mechanic": "hazard_zone", "setup": { "placeAt": { "player": "searchlight" }, "entityStates": { "searchlight": "on" } }, "ticks": 60, "assert": { "runState": "lost" } },
    { "id": "clock_wins", "kind": "keypoint", "mechanic": "timer", "ticks": 3600, "assert": { "runState": "won" } },
    { "id": "winnable", "kind": "reachability", "assert": { "runState": "won" } }
  ],
  "budgets": { "maxEntities": 40, "maxRules": 120, "maxTriangles": 200000 }
}
