{
  "name": "worldsmith",
  "version": "0.1.0",
  "private": true,
  "description": "Prompt to a playable 3D mini-world in the browser: the model emits a declarative graph, a hand-written deterministic interpreter runs it.",
  "engines": {
    "node": ">=22.17.0 <23"
  },
  "scripts": {
    "demo:subscription": "vitest run --config vitest.measure.mts evals/reality-compiler/subscription-demo.measure.ts",
    "prepare": "git config core.hooksPath .githooks",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert @measure",
    "prove:fallback": "node scripts/prove-fallback-isolation.mjs",
    "build:from-tag": "node scripts/build-from-tag.mjs",
    "gate:license": "node scripts/license-gate.mjs",
    "gate:cleanroom": "node scripts/cleanroom-check.mjs",
    "disclosure": "node scripts/license-gate.mjs --sync",
    "measure:grammar": "playwright test e2e/local-model-grammar.spec.ts --grep @measure",
    "measure:corpus": "playwright test e2e/corpus-measure.spec.ts --grep @measure",
    "prove:budgets": "node scripts/prove-budgets.mjs",
    "measure:mesh": "playwright test e2e/mesh-budget.spec.ts --project=chromium --grep @measure",
    "measure:divergence": "playwright test e2e/divergence.spec.ts --grep @measure",
    "measure:rejects": "vitest run evals/__tests__/reject-causes.test.ts",
    "measure:hostile": "vitest run evals/__tests__/hostile-report.test.ts",
    "author:worlds": "vitest run --config vitest.measure.mts evals/worldstream/author-worlds.measure.ts",
    "measure:worldstream-latency": "vitest run --config vitest.measure.mts evals/worldstream/live-latency.measure.ts",
    "measure:worldstream-create": "vitest run --config vitest.measure.mts evals/worldstream/live-create.measure.ts",
    "measure:worldstream-replay": "vitest run --config vitest.measure.mts evals/worldstream/replay-create.measure.ts",
    "measure:reality-compiler": "vitest run --config vitest.measure.mts evals/reality-compiler/benchmark.measure.ts",
    "measure:reality-compiler-cold": "vitest run --config vitest.measure.mts evals/reality-compiler/cold-browser.measure.ts",
    "measure:reality-compiler-subscription": "vitest run --config vitest.measure.mts evals/reality-compiler/subscription-benchmark.measure.ts",
    "study:reality-compiler": "vitest run --config vitest.measure.mts evals/reality-compiler/study-session.measure.ts",
    "evaluate:reality-compiler": "vitest run --config vitest.measure.mts evals/reality-compiler/review.measure.ts"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.84",
    "@react-three/fiber": "9.7.x",
    "next": "16.3.x",
    "pure-rand": "8.4.x",
    "react": "19.2.x",
    "react-dom": "19.2.x",
    "rfc6902": "5.3.x",
    "three": "0.185.1",
    "zod": "4.4.x"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.x",
    "@next/env": "16.3.x",
    "@playwright/test": "1.62.x",
    "@types/node": "26.2.x",
    "@types/react": "19.2.x",
    "@types/react-dom": "19.2.x",
    "@types/three": "0.185.x",
    "typescript": "6.0.x",
    "vitest": "4.1.x"
  },
  "overrides": {
    "three": "0.185.1"
  }
}
