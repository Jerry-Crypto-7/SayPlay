{
  "name": "worldsmith",
  "version": "0.1.0",
  "private": true,
  "description": "Prompt to a playable 3D mini-world in the browser: the model emits a declarative graph, a hand-written deterministic interpreter runs it.",
  "engines": {
    "node": ">=22.17.0 <23"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert @measure",
    "gate:license": "node scripts/license-gate.mjs",
    "gate:cleanroom": "node scripts/cleanroom-check.mjs",
    "disclosure": "node scripts/license-gate.mjs --sync"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.7.x",
    "@react-three/postprocessing": "3.1.3",
    "meshoptimizer": "1.1.1",
    "n8ao": "2.0.1",
    "next": "16.3.x",
    "postprocessing": "6.39.5",
    "pure-rand": "8.4.x",
    "react": "19.2.x",
    "react-dom": "19.2.x",
    "rfc6902": "5.3.x",
    "three": "0.185.1",
    "three.quarks": "0.17.1",
    "zod": "4.4.x"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@next/bundle-analyzer": "16.3.x",
    "@next/env": "16.3.x",
    "@playwright/test": "1.62.x",
    "@types/node": "26.2.x",
    "@types/react": "19.2.x",
    "@types/react-dom": "19.2.x",
    "@types/three": "0.185.x",
    "gltf-validator": "^2.0.0-dev.3.10",
    "sharp": "0.35.3",
    "typescript": "6.0.x",
    "vitest": "4.1.x"
  },
  "overrides": {
    "three": "0.185.1"
  }
}
