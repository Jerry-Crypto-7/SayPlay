{
  "name": "worldsmith",
  "version": "0.1.0",
  "private": true,
  "description": "Prompt to a playable 3D mini-world in the browser: the model emits a declarative graph, a hand-written deterministic interpreter runs it.",
  "engines": {
    "node": ">=22.17.0 <23"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prove:fallback": "node scripts/prove-fallback-isolation.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.x",
    "next": "16.3.x",
    "pure-rand": "8.4.x",
    "react": "19.2.x",
    "react-dom": "19.2.x",
    "rfc6902": "5.3.x",
    "three": "0.185.1",
    "zod": "4.4.x"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.x",
    "@next/env": "16.3.x",
    "@playwright/test": "1.62.x",
    "@types/node": "26.2.x",
    "@types/react": "19.2.x",
    "@types/react-dom": "19.2.x",
    "@types/three": "0.185.x",
    "typescript": "6.0.x",
    "vitest": "4.1.x"
  },
  "overrides": {
    "three": "0.185.1"
  }
}
