# NOT DEPLOYED. Copy and complete only on an authorized Linux host.
# This file contains no credentials and cannot pass preflight as shipped.
WORLDSTREAM_HOST_READY=no
WORLDSMITH_OWNER_IDENTITY=trusted-proxy
# Operator injection on authorized host only; never store a real value here.
WORLDSMITH_OWNER_PROXY_SECRET=
WORLDSMITH_BRANCH=live
WORLDSMITH_MODEL_ENDPOINT=codex-cli
WORLDSMITH_MODEL=gpt-6-astra
WORLDSMITH_MODEL_EFFORT=medium
WORLDSMITH_MODEL_PROFILE=subscription
WORLDSMITH_MODEL_KEY=cli-enabled
WORLDSMITH_CODEX_JS=/opt/worldstream-codex/node_modules/@openai/codex/bin/codex.js
WORLDSMITH_CALL_CAP=200
WORLDSMITH_UPSTREAM_TIMEOUT_MS=240000
# Fill verified accounting conversion rates, not a claim of subscription charges.
WORLDSMITH_USD_PER_MTOK_IN=
WORLDSMITH_USD_PER_MTOK_OUT=
WORLDSMITH_SPEND_CAP_USD=
# Existing REST ledger adapter. Durable and shared; no process-memory deployment.
WORLDSMITH_SPEND_STORE_URL=
WORLDSMITH_SPEND_STORE_TOKEN=
WORLDSMITH_SPEND_STORE_PREFIX=worldstream:p20:production
