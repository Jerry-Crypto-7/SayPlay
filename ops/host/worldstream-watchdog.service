[Unit]
Description=WORLDSTREAM read-only health watchdog
After=worldstream.service

[Service]
Type=oneshot
User=worldstream
Group=worldstream
WorkingDirectory=/srv/worldstream/current
ExecStart=/usr/bin/node ops/watchdog/worldstream.mjs --target http://127.0.0.1:3116 --log /var/log/worldstream/watchdog.jsonl --timeout-ms 25000
TimeoutStartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/worldstream
