{
  "_comment": "API-format graphs for ComfyUI 0.37. image_* turns a prompt into a PNG, mesh turns that PNG into a vertex-coloured GLB via native TRELLIS.2. Sampler settings follow the official template 3d_pixal3d_trellis2_image_to_model.json (TRELLIS.2 branch); the 1536 upsample stage and UV texture baking are left out because the target is a low-poly vertex-coloured model. Code fills prompt.text, *.seed, save_*.filename_prefix and load_image.image.",
  "image_zimage": {
    "unet": {"class_type": "UNETLoader", "inputs": {"unet_name": "z_image_turbo_bf16.safetensors", "weight_dtype": "default"}},
    "clip": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen_3_4b.safetensors", "type": "lumina2", "device": "default"}},
    "vae": {"class_type": "VAELoader", "inputs": {"vae_name": "ae.safetensors"}},
    "shift": {"class_type": "ModelSamplingAuraFlow", "inputs": {"model": ["unet", 0], "shift": 3}},
    "prompt": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["clip", 0], "text": ""}},
    "negative": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["prompt", 0]}},
    "latent": {"class_type": "EmptySD3LatentImage", "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
    "sampler": {"class_type": "KSampler", "inputs": {"model": ["shift", 0], "positive": ["prompt", 0], "negative": ["negative", 0], "latent_image": ["latent", 0], "seed": 0, "steps": 8, "cfg": 1, "sampler_name": "res_multistep", "scheduler": "simple", "denoise": 1}},
    "decode": {"class_type": "VAEDecode", "inputs": {"samples": ["sampler", 0], "vae": ["vae", 0]}},
    "save_image": {"class_type": "SaveImage", "inputs": {"images": ["decode", 0], "filename_prefix": "gen3d/image"}}
  },
  "image_klein": {
    "unet": {"class_type": "UNETLoader", "inputs": {"unet_name": "flux-2-klein-4b.safetensors", "weight_dtype": "default"}},
    "clip": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen_3_4b.safetensors", "type": "flux2", "device": "default"}},
    "vae": {"class_type": "VAELoader", "inputs": {"vae_name": "flux2-vae.safetensors"}},
    "prompt": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["clip", 0], "text": ""}},
    "negative": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["prompt", 0]}},
    "guider": {"class_type": "CFGGuider", "inputs": {"model": ["unet", 0], "positive": ["prompt", 0], "negative": ["negative", 0], "cfg": 1}},
    "select": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler"}},
    "sigmas": {"class_type": "Flux2Scheduler", "inputs": {"steps": 4, "width": 1024, "height": 1024}},
    "latent": {"class_type": "EmptyFlux2LatentImage", "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
    "noise": {"class_type": "RandomNoise", "inputs": {"noise_seed": 0}},
    "sampler": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["noise", 0], "guider": ["guider", 0], "sampler": ["select", 0], "sigmas": ["sigmas", 0], "latent_image": ["latent", 0]}},
    "decode": {"class_type": "VAEDecode", "inputs": {"samples": ["sampler", 0], "vae": ["vae", 0]}},
    "save_image": {"class_type": "SaveImage", "inputs": {"images": ["decode", 0], "filename_prefix": "gen3d/image"}}
  },
  "mesh": {
    "load_image": {"class_type": "LoadImage", "inputs": {"image": ""}},
    "bg_model": {"class_type": "LoadBackgroundRemovalModel", "inputs": {"bg_removal_name": "birefnet.safetensors"}},
    "bg_mask": {"class_type": "RemoveBackground", "inputs": {"bg_removal_model": ["bg_model", 0], "image": ["load_image", 0]}},
    "crop": {"class_type": "ImageCropToMask", "inputs": {"images": ["load_image", 0], "masks": ["bg_mask", 0], "width": 1024, "height": 1024, "pad_factor": 1.1, "grow_mask": 0, "background": "#000000"}},
    "dino": {"class_type": "CLIPVisionLoader", "inputs": {"clip_name": "dino_v3_vit_l.safetensors"}},
    "cond": {"class_type": "Trellis2Conditioning", "inputs": {"clip_vision_model": ["dino", 0], "image": ["crop", 0]}},
    "unet": {"class_type": "UNETLoader", "inputs": {"unet_name": "trellis_2_bf16.safetensors", "weight_dtype": "default"}},
    "shape_vae": {"class_type": "VAELoader", "inputs": {"vae_name": "trellis_2_shape_vae_bf16.safetensors"}},
    "texture_vae": {"class_type": "VAELoader", "inputs": {"vae_name": "trellis_2_texture_vae_bf16.safetensors"}},
    "cfg_structure": {"class_type": "CFGOverride", "inputs": {"model": ["unet", 0], "cfg": 1, "start_percent": 0.667, "end_percent": 1}},
    "rescale_structure": {"class_type": "RescaleCFG", "inputs": {"model": ["cfg_structure", 0], "multiplier": 0.7}},
    "shift_structure": {"class_type": "ModelSamplingSD3", "inputs": {"model": ["rescale_structure", 0], "shift": 5}},
    "cfg_shape": {"class_type": "CFGOverride", "inputs": {"model": ["unet", 0], "cfg": 1, "start_percent": 0.769, "end_percent": 1}},
    "rescale_shape": {"class_type": "RescaleCFG", "inputs": {"model": ["cfg_shape", 0], "multiplier": 0.5}},
    "empty": {"class_type": "EmptyTrellis2LatentStructure", "inputs": {"batch_size": 1}},
    "structure": {"class_type": "KSampler", "inputs": {"model": ["shift_structure", 0], "positive": ["cond", 0], "negative": ["cond", 1], "latent_image": ["empty", 0], "seed": 56, "steps": 12, "cfg": 7.5, "sampler_name": "euler", "scheduler": "normal", "denoise": 1}},
    "voxel": {"class_type": "VaeDecodeStructureTrellis2", "inputs": {"samples": ["structure", 0], "vae": ["shape_vae", 0], "resolution": "32"}},
    "shape_stage": {"class_type": "Trellis2ShapeStage", "inputs": {"positive": ["cond", 0], "negative": ["cond", 1], "voxel": ["voxel", 0]}},
    "shape": {"class_type": "KSampler", "inputs": {"model": ["rescale_shape", 0], "positive": ["shape_stage", 0], "negative": ["shape_stage", 1], "latent_image": ["shape_stage", 2], "seed": 42, "steps": 20, "cfg": 7.5, "sampler_name": "euler", "scheduler": "normal", "denoise": 1}},
    "shape_mesh": {"class_type": "VaeDecodeShapeTrellis", "inputs": {"samples": ["shape", 0], "vae": ["shape_vae", 0]}},
    "texture_stage": {"class_type": "Trellis2TextureStage", "inputs": {"positive": ["shape_stage", 0], "negative": ["shape_stage", 1], "shape_latent": ["shape", 0]}},
    "texture": {"class_type": "KSampler", "inputs": {"model": ["unet", 0], "positive": ["texture_stage", 0], "negative": ["texture_stage", 1], "latent_image": ["texture_stage", 2], "seed": 43, "steps": 12, "cfg": 1, "sampler_name": "euler", "scheduler": "normal", "denoise": 1}},
    "colors": {"class_type": "VaeDecodeTextureTrellis", "inputs": {"samples": ["texture", 0], "vae": ["texture_vae", 0], "shape_subdivides": ["shape_mesh", 1]}},
    "remesh": {"class_type": "RemeshMesh", "inputs": {"mesh": ["shape_mesh", 0], "resolution": 512, "sign_mode": "udf", "sign_mode.qef": false, "sign_mode.drop_inverted_components": false, "sign_mode.drop_enclosed_components": false, "band": 1.0, "project_back": 0.0, "fix_poles": false, "smooth_iters": 20, "drop_small_components": 0.01, "precluster_max_verts": 20000000}},
    "decimate": {"class_type": "DecimateMesh", "inputs": {"mesh": ["remesh", 0], "target_face_count": 20000, "placement_mode": "midpoint"}},
    "paint": {"class_type": "PaintMesh", "inputs": {"mesh": ["decimate", 0], "voxel_colors": ["colors", 0]}},
    "glb": {"class_type": "MeshToFile3D", "inputs": {"mesh": ["paint", 0]}},
    "save_glb": {"class_type": "SaveGLB", "inputs": {"mesh": ["glb", 0], "filename_prefix": "gen3d/mesh"}}
  }
}
