{
  "targets": [
    { "name": "repository", "url": "https://github.com/Jerry-Crypto-7/Hackathon" },
    { "name": "demo", "url": "https://worldstream-sigma.vercel.app" },
    { "name": "backend", "url": "https://worldstream-sigma.vercel.app/api/health" }
  ],
  "intervalSeconds": 300,
  "coverageUntil": "2026-12-31",
  "alert": {
    "channel": "github-issue",
    "destination": "https://github.com/Jerry-Crypto-7/Hackathon/issues"
  },
  "external": {
    "service": "GitHub Actions scheduled workflow .github/workflows/health-probe.yml",
    "intervalMin": 10,
    "targets": [
      "https://worldstream-sigma.vercel.app",
      "https://worldstream-sigma.vercel.app/api/health",
      "https://worldstream-sigma.vercel.app/play",
      "https://worldstream-sigma.vercel.app/api/build-id"
    ]
  },
  "heartbeatPath": "ops/monitoring/heartbeat.jsonl"
}
