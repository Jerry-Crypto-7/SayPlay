      "$type": "color",
      "$value": "#FF5A36",
      "$description": "Primary action, brand accent, danger-in-game"
    },
    "tomato-deep": {
      "$type": "color",
      "$value": "#E8421F",
      "$description": "Illustration shading only. Never a text background"
    },
    "sun": {
      "$type": "color",
      "$value": "#FFC530",
      "$description": "Secondary accent: mic, timer, rewards, highlights"
    },
    "sun-deep": {
      "$type": "color",
      "$value": "#E9A800",
      "$description": "Illustration shading only. Never a text background"
    },
    "sun-soft": {
      "$type": "color",
      "$value": "#FFD66B",
      "$description": "Idea card (sun variant)"
    },
    "mint": {
      "$type": "color",
      "$value": "#9BE3B0",
      "$description": "Idea card, success surface"
    },
    "mint-deep": {
      "$type": "color",
      "$value": "#5CC486",
      "$description": "Illustration shading only. Never a text background"
    },
    "sky": {
      "$type": "color",
      "$value": "#8FD3FF",
      "$description": "Idea card, info surface, default game sky"
