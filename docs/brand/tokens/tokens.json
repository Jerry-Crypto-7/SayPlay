{
  "$description": "Sayplay design tokens v1.0 (W3C DTCG format). Source of truth - generate platform files from this.",
  "color": {
    "ink": {
      "$type": "color",
      "$value": "#1F1A17",
      "$description": "Primary text, all outlines, hard shadows, icons"
    },
    "ink-soft": {
      "$type": "color",
      "$value": "#5A524B",
      "$description": "Secondary text, helper text"
    },
    "ink-faint": {
      "$type": "color",
      "$value": "#6E655D",
      "$description": "Placeholder text, disabled labels"
    },
    "cream": {
      "$type": "color",
      "$value": "#FFF3DF",
      "$description": "App background (canvas)"
    },
    "cream-deep": {
      "$type": "color",
      "$value": "#FFE7C2",
      "$description": "Pressed/hover fill on cream, secondary chips"
    },
    "paper": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Surfaces: inputs, cards, sheets, HUD pills"
    },
