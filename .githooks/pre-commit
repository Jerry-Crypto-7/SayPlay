#
# Na čerstvém klonu cleanroom-check SELŽE, protože jeho seznam je mimo verzování.
# Je to záměr a postup je v ops/cleanroom-provisioning.md.

set -e

node scripts/license-gate.mjs
node scripts/cleanroom-check.mjs
