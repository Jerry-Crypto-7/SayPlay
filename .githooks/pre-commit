#!/bin/sh
# Licenční a clean-room brána (RULES.md §2 disclosure, §4 kontrola před npm install,
# DESIGN-BOOK.md §12 clean-room).
#
# Hook je verzovaný, ne schovaný v .git/hooks — aktivuje se jednou:
#   git config core.hooksPath .githooks
#
# Proč pre-commit a ne jen CI: obojí hlídá věc, kterou commit dělá nevratnou.
# Proprietární identifikátor a nedeklarovaná licence se z historie zpětně
# nevyndají, jen přepíšou — a přepis zanechá stopu.
#
# ŽÁDNÉ `set -e` MEZI BRÁNAMI, a je to to hlavní, co tenhle soubor dělá.
# Do 15. 8. 2026 tu `set -e` bylo, takže první selhavší brána tu druhou vůbec
# nespustila. Když pak cleanroom-check začal nad nenaplněným seznamem správně
# selhávat, přestal se licenční registr kontrolovat úplně — a jediná rutinní
# cesta dál byla `git commit --no-verify`, která vypne obě. Přísnější brána tím
# vypnula tu druhou. Obě proto běží vždycky a výsledky se sčítají až na konci.

status=0

node scripts/license-gate.mjs || status=1

# Nenaplněný seznam zakázaných identifikátorů je stav, ve kterém se tenhle
# repozitář nachází a bude nacházet, dokud k tomu modulu někdo nedostane přístup.
# Samostatný běh (`npm run gate:cleanroom`, CI) v něm SELŽE a je to tak správně —
# brána, která nehlídá nic, to musí říct. Hook je jediné místo, kde se to promíjí,
# protože alternativa není přísnější hook, ale `--no-verify` a s ním i vypnutá
# licenční brána. Prominutí je vidět na každém commitu, viz banner níž.
CLEANROOM_ALLOW_UNPROVISIONED=1 node scripts/cleanroom-check.mjs || status=1

if [ "$status" -ne 0 ]; then
  echo ""
  echo "Commit zastavený branou. Obejití je git commit --no-verify a vypne OBĚ brány."
fi

exit "$status"
